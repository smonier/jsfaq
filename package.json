{
  "name": "jsfaq",
  "version": "1.1.1",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/**/*.cnd",
    "settings"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "clean": "rm -rf dist/",
    "deploy": "jahia-deploy",
    "dev": "vite build --watch",
    "format": "prettier --write --list-different .",
    "lint": "eslint .",
    "package": "yarn pack --out dist/package.tgz",
    "release": "yarn build && yarn pack --out dist/jsfaq-v$(node -p 'require(\"./package.json\").version').tgz",
    "test": "vitest run",
    "watch": "run dev",
    "watch:callback": "run package && run deploy"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^1.49.0",
    "@eslint/compat": "^1.2.9",
    "@eslint/js": "^9.26.0",
    "@jahia/javascript-modules-library": "^1.0.1",
    "@jahia/vite-plugin": "^1.0.1",
    "@types/react": "^19.1.2",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "i18next": "^25.0.2",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-i18next": "^15.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^7.0.0",
    "vitest": "^3"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "jahia": {
    "required-version": "8.2.1.0",
    "name": "jsfaq",
    "snapshot": false,
    "module-dependencies": "default,javascript-modules-engine=[1,2)",
    "module-type": "module",
    "static-resources": "/javascript/apps,/dist/client,/dist/assets,/locales,/images,/icons",
    "server": "dist/server/index.js",
    "maven": {
      "groupId": "org.jahia.modules.se.javascript",
      "distributionManagement": {
        "repository": {
          "id": "jahia-releases",
          "url": "https://devtools.jahia.com/nexus/content/repositories/jahia-releases"
        },
        "snapshotRepository": {
          "id": "jahia-snapshots",
          "url": "https://devtools.jahia.com/nexus/content/repositories/jahia-snapshots"
        }
      }
    }
  }
}
